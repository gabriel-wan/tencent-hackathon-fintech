# Internal Brain - example environment file
#
# Copy to `.env` and fill in real values locally. `.env` is git-ignored.
# NEVER commit real credentials. Every value here is a placeholder.
#
# The tech stack is not yet decided (see DECISIONS.md, ADR-001), so this file
# only lists the categories of configuration we already know we will need.
# Add or rename variables when the corresponding component is actually built,
# and update DEVELOPMENT.md at the same time.

# ---- Application ----
APP_ENV=development
LOG_LEVEL=info

# ---- LLM provider (TBD - see ADR-006) ----
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=

# ---- Source connectors (TBD which are real vs. mocked - see ADR-004) ----
# Confluence
# CONFLUENCE_BASE_URL=
# CONFLUENCE_API_TOKEN=
# Jira
# JIRA_BASE_URL=
# JIRA_API_TOKEN=
# Slack
# SLACK_BOT_TOKEN=
# Google Drive
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# ---- Storage / index (TBD - see ADR-005) ----
# DATABASE_URL=
# VECTOR_STORE_URL=

# ---- Audit log (TBD - see ADR-007) ----
# AUDIT_LOG_SIGNING_KEY=   # for tamper-evidence, if the team chooses a signing/hash-chain design

# ---- Tencent Cloud (only if adopted - see docs/hackathon/tool-usage.md) ----
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# TENCENTCLOUD_REGION=
