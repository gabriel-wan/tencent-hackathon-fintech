# Copy to frontend/.env. NEXT_PUBLIC_* vars reach the browser: no secrets there.

# Overridden in docker-compose.yml
BACKEND_URL=http://localhost:8000

# Mock mode (development only): fake replies for POST /api/query, labelled
# MOCK DATA in the header. Ignored in production builds. Restart `npm run dev`
# after changing it. Pick a state with a keyword in the question, e.g.
# mock:not-found, mock:unavailable, mock:offline (see lib/api/mock.ts).
# NEXT_PUBLIC_API_MOCK=1
