# Copy to frontend/.env. NEXT_PUBLIC_* vars reach the browser: no secrets there.

# Where the frontend's server reaches the backend (the /api proxy, server components, /status).
# Overridden in docker-compose.yml, where the backend's address is http://backend:8000.
BACKEND_SERVER_URL=http://localhost:8000
# The backend address your BROWSER uses: the sign-in and Connect links go straight to it, because the
# OAuth redirect (Google, Slack, Atlassian) must start and end on the backend.
BACKEND_LOCAL_URL=http://localhost:8000

# Mock mode (development only): fake replies for POST /api/query, labelled
# MOCK DATA in the header. Ignored in production builds. Restart `npm run dev`
# after changing it. Pick a state with a keyword in the question, e.g.
# mock:not-found, mock:unavailable, mock:offline (see lib/api/mock.ts).
# NEXT_PUBLIC_API_MOCK=1
