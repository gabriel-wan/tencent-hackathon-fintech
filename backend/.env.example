# Copy to backend/.env. Placeholders only; never commit .env.
# Also loaded by the db service. Commented-out vars are for components not built yet.

APP_ENV=development
LOG_LEVEL=info

# Database (POSTGRES_HOST is set in docker-compose.yml)
POSTGRES_USER=brain
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brain

# LLM and embeddings (ADR-005, ADR-006): Tencent Cloud TokenHub, Singapore.
# The API key must be allowed to use both models (TokenHub console > API Key > Access Scope).
LLM_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1
LLM_API_KEY=
LLM_MODEL=hy3
EMBEDDING_MODEL=kinfra-text-embedding-0.6b

# Connect accounts: users sign in to each tool (ADR-002). Setup: docs/connectors/GUIDE.md
APP_URL=http://localhost:8000            # required; public backend URL (https in production: cookies are Secure only then)
# FRONTEND_URL=http://localhost:3000     # where users land after connecting
# TOKEN_ENCRYPTION_KEY=                  # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_TEAM_ID=                         # the company workspace (T...); sign-ins from others are rejected
# ATLASSIAN_CLIENT_ID=                   # one OAuth (3LO) app covers Jira and Confluence
# ATLASSIAN_CLIENT_SECRET=
# ATLASSIAN_CLOUD_ID=                    # the company site; sign-ins without it are rejected
# GOOGLE_ALLOWED_ACCOUNTS=               # company Workspace domain(s) and/or test emails, comma-separated; others are rejected
# (Google uses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET below)

# Admin credentials for background work (docs/connectors/). Check with: python -m app.connectors
# Jira + Confluence: one site, token of an Atlassian admin
# ATLASSIAN_BASE_URL=https://yourteam.atlassian.net
# ATLASSIAN_EMAIL=
# ATLASSIAN_API_TOKEN=
# Google Drive, Workspace mode (used when set): key JSON on one line, in single quotes
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# GOOGLE_ADMIN_EMAIL=
# Google OAuth app: used for every Google sign-in (admin now, users per ADR-002)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Google Drive, personal mode (used when no service account): the admin's own sign-in
# GOOGLE_REFRESH_TOKEN=
# Slack: internal app bot token (xoxb-...), scopes in docs/connectors/SLACK.md
# SLACK_BOT_TOKEN=

# Audit log (ADR-007)
# AUDIT_LOG_SIGNING_KEY=

# Tencent Cloud (only if adopted)
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# TENCENTCLOUD_REGION=
