# Copy to backend/.env. Placeholders only; never commit .env.
# Also loaded by the db service. Commented-out vars are for components not built yet.

APP_ENV=development
LOG_LEVEL=info

# Database (POSTGRES_HOST is set in docker-compose.yml)
POSTGRES_USER=brain
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brain

# LLM and embeddings (ADR-005, ADR-006): Tencent Cloud TokenHub, Singapore.
# The API key must be allowed to use both models (TokenHub console > API Key > Access Scope).
LLM_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1
LLM_API_KEY=
LLM_MODEL=hy3
EMBEDDING_MODEL=kinfra-text-embedding-0.6b

# Connectors (ADR-004)
# CONFLUENCE_BASE_URL=
# CONFLUENCE_API_TOKEN=
# JIRA_BASE_URL=
# JIRA_API_TOKEN=
# SLACK_BOT_TOKEN=
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# Audit log (ADR-007)
# AUDIT_LOG_SIGNING_KEY=

# Tencent Cloud (only if adopted)
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# TENCENTCLOUD_REGION=
