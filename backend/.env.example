# Copy to backend/.env. Never commit .env. Every variable: docs/RUNNING.md (appendix).

APP_ENV=development
APP_URL=http://localhost:8000
LOG_LEVEL=info
# TOKEN_ENCRYPTION_KEY=uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FRONTEND_URL=http://localhost:3000

POSTGRES_USER=brain
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brain
# The app's own database login (knowbuddy_app): it can read and add audit records, never change
# them. Different from POSTGRES_PASSWORD (the owner, used only by migrations). Required.
APP_DB_PASSWORD=change-me-too

LLM_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1
LLM_API_KEY=
LLM_MODEL=hy3
EMBEDDING_MODEL=kinfra-text-embedding-0.6b

# Connectors: user sign-in (docs/connectors/SETUP.md)
# GOOGLE_CLIENT_ID= < The public name tag that tells Google which app is asking when a user clicks Connect on Google Drive. >
# GOOGLE_CLIENT_SECRET= < The password our backend gives Google to prove it really is that app, before Google hands over the user's Drive access. >
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# ATLASSIAN_CLIENT_ID= < The public name tag that tells Atlassian which app is asking when a user clicks Connect on Jira and Confluence. >
# ATLASSIAN_CLIENT_SECRET= < The private password our backend gives Atlassian to prove it really is that app, before Atlassian hands over the user's Jira and Confluence access. >
# Companies are not set here: the first full member (not a guest) to connect Slack from a new
# workspace creates one; its admin then connects Jira to add the Atlassian site (docs/RUNNING.md section 5).
